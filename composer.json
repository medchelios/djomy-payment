{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tmoh/djomy-payment",
    "type": "library",
    "description": "Framework-agnostic PHP package (Laravel 10+, Symfony, standalone) for Djomy Payment Platform API integration",
    "version": "1.1.1",
    "keywords": [
        "payment",
        "payment-links",
        "djomy",
        "laravel",
        "symfony",
        "php",
        "api"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "tmoh",
            "email": "toure1206@gmail.com",
            "homepage": "https://tmoh.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "pestphp/pest": "^1.22|^2.36|^3.7|^4.4.1|^5.0",
        "pestphp/pest-plugin-laravel": "^1.3|^2.4|^3.1|^4.0|^5.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "laravel/framework": "Required when using the Laravel service provider, facade and configuration file"
    },
    "autoload": {
        "psr-4": {
            "Tmoh\\DjomyPayment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tmoh\\DjomyPayment\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "format": "pint",
        "format-check": "pint --test",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tmoh\\DjomyPayment\\DjomyServiceProvider"
            ],
            "aliases": {
                "Djomy": "Tmoh\\DjomyPayment\\Facades\\Djomy",
                "DjomyWebhook": "Tmoh\\DjomyPayment\\Facades\\DjomyWebhook"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
